# Variáveis para docker-compose.prod.yml. Copie para .env.prod e NUNCA versione o arquivo real.
POSTGRES_PASSWORD=troque-por-uma-senha-longa-e-aleatoria
# Endereço público do site (com https), usado em CORS e nos links enviados aos clientes
PUBLIC_SITE_URL=https://www.suabarbearia.com.br
# Slug da empresa exibida no site (vazio = a única empresa cadastrada)
PUBLIC_COMPANY_SLUG=
# Número de proxies na frente da aplicação (1 com Caddy/Nginx)
TRUST_PROXY=1
