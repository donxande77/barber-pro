# Copie para .env e ajuste. Nunca versione o .env real.
NODE_ENV=development
PORT=3333
DATABASE_URL="postgresql://barber:TROQUE_A_SENHA@localhost:5432/barberpro?schema=public"
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=bp_session
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_15MIN=20
# Número de proxies reversos confiáveis à frente da API (0 em desenvolvimento)
TRUST_PROXY=0
# Pasta das imagens enviadas pelo painel
UPLOAD_DIR=uploads
# Endereço do site (links enviados ao cliente para gerenciar agendamento e avaliar)
PUBLIC_SITE_URL=http://localhost:5173
# Empresa mostrada no site público (vazio = a primeira cadastrada). Para a demonstração: barbearia-demonstracao
PUBLIC_COMPANY_SLUG=
PUBLIC_BOOKING_RATE_LIMIT_PER_15MIN=15
# Em produção sem Docker: caminho do build do frontend para a API servir o site (ex.: ../frontend/dist)
FRONTEND_DIST=

# Usados apenas por "npm run db:seed" para criar a empresa e o primeiro proprietário
SEED_COMPANY_NAME="Nome da sua barbearia"
SEED_COMPANY_SLUG=minha-barbearia
SEED_OWNER_NAME="Seu nome"
SEED_OWNER_EMAIL=voce@exemplo.com
SEED_OWNER_PASSWORD=TroqueEstaSenha123
