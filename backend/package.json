{
  "name": "barber-pro-backend",
  "version": "1.0.0",
  "description": "API do Barber Pro (Express + Prisma + PostgreSQL)",
  "scripts": {
    "test": "vitest run",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "postinstall": "prisma generate",
    "test:db-reset": "node scripts/reset-test-db.js"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "luxon": "^3.7.2",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
